[
  {"name": "ts",           "type": "TIMESTAMP", "mode": "REQUIRED", "description": "Request time. Source logs use +05:30 (IST); BigQuery stores TIMESTAMP in UTC"},
  {"name": "client_ip",    "type": "STRING",    "mode": "REQUIRED", "description": "Client IPv4 address"},
  {"name": "method",       "type": "STRING",    "mode": "REQUIRED", "description": "HTTP method"},
  {"name": "endpoint",     "type": "STRING",    "mode": "REQUIRED", "description": "Path template, numeric ids replaced by {id}"},
  {"name": "path",         "type": "STRING",    "mode": "NULLABLE", "description": "Requested path without query string"},
  {"name": "query_string", "type": "STRING",    "mode": "NULLABLE", "description": "Query string (after ?)"},
  {"name": "protocol",     "type": "STRING",    "mode": "NULLABLE", "description": "HTTP protocol version"},
  {"name": "status",       "type": "INT64",     "mode": "REQUIRED", "description": "HTTP status code"},
  {"name": "bytes_sent",   "type": "INT64",     "mode": "NULLABLE", "description": "Response body size in bytes"},
  {"name": "response_ms",  "type": "INT64",     "mode": "NULLABLE", "description": "Server response time in milliseconds"},
  {"name": "referrer",     "type": "STRING",    "mode": "NULLABLE", "description": "HTTP referrer (empty if none)"},
  {"name": "user_agent",   "type": "STRING",    "mode": "NULLABLE", "description": "Raw User-Agent header"},
  {"name": "ua_class",     "type": "STRING",    "mode": "NULLABLE", "description": "browser / mobile_browser / mobile_app / search_bot / script_or_tool"}
